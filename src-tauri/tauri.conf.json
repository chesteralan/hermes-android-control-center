{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Control Center",
  "version": "0.1.0",
  "identifier": "com.hermes.controlcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Control Center",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGOTI1QkQwNDAxNTZEOTcKUldTWGJSVkEwRnVTejNpbFpOK1h1WXM0aGF3S1lnelpUK3B1WjV5TVVjc01QYlAvVVFxZWhzeUIK",
      "endpoints": [
        "https://github.com/chesteralan/hermes-android-control-center/releases/latest/download/latest.json"
      ]
    }
  }
}
