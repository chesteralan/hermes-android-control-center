#!/data/data/com.termux/files/usr/bin/sh
set -eu

APP_HOME=${HERMES_CONTROL_HOME:-"$HOME/.local/share/hermes-control"}
CONFIG=${HERMES_CONTROL_CONFIG:-"$HOME/.config/hermes-control.toml"}
TOKEN_FILE="$HOME/.config/hermes-control.token"
if [ -f "$TOKEN_FILE" ]; then
	HERMES_CONTROL_TOKEN=$(cat "$TOKEN_FILE")
	export HERMES_CONTROL_TOKEN
fi
exec "$APP_HOME/venv/bin/hermes-control" --config "$CONFIG"